# Austin Event Sites to scrape (comma-separated)
AUSTIN_EVENT_SITES=

# Telegram notification channel ID (from @getmyid_bot)
NOTIFICATION_CHANNEL_ID=

# Telegram bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Eventbrite API (optional — only needed for the Eventbrite API data source)
# Private token from https://www.eventbrite.com/platform/api-keys/ (recommended)
EVENTBRITE_PRIVATE_TOKEN=
# OAuth app credentials (authorization-code flow)
EVENTBRITE_CLIENT_ID=
EVENTBRITE_CLIENT_SECRET=
EVENTBRITE_REDIRECT_URI=http://localhost:8080/oauth/redirect
# Event ID used by bin/eventbrite_smoke_test
EVENTBRITE_TEST_EVENT_ID=

# Log level: debug, info, warn, error, fatal
LOG_LEVEL=info
