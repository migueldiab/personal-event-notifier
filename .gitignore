# See https://help.github.com/articles/ignoring-files for more about ignoring files.

# Compiled
*.gem
*.so
*.o
*.a
*.mkmf.log

# Bundler
.bundle/
Gemfile.lock

# RSpec
.rspec

# Coverage
coverage/

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp
*.swo

# Temp/Logs
tmp/
logs/

# Environment
.env
.env.local
.env.*.local

# Specs (fixtures are committed test data; only ignore local config files)
spec/fixtures/*.yml
spec/fixtures/*.yaml

# Vendor
vendor/bundle
vendor/cache

# Database
*.sqlite3
*.sqlite3-journal


